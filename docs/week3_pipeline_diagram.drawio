<mxfile host="app.diagrams.net">
  <diagram id="week3-pipeline" name="Week 3 V1 Data Pipeline">
    <mxGraphModel dx="1460" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="670" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;FYPAdvisor — Week 3 V1 Data Pipeline (Pathway A: PDF/TXT)&lt;/b&gt;&lt;br&gt;&lt;span style=&amp;quot;font-size:11px&amp;quot;&gt;Expands only the DATA component of docs/week2_architecture_v1.png (Departmental FYP Knowledge Sources). Red boxes = annotated failure points.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1f3b5c;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1400" height="60" as="geometry" /></mxCell>
        <mxCell id="src" value="&lt;b&gt;SOURCE&lt;/b&gt;&lt;br&gt;data/raw/fyp_documents/&lt;br&gt;S01 FKM UGP Guideline 2014&lt;br&gt;S02 MSc BIA Project Handbook&lt;br&gt;S03 UTM Thesis Manual 2015&lt;br&gt;3 PDFs · 129 pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="200" height="160" as="geometry" /></mxCell>
        <mxCell id="ing" value="&lt;b&gt;INGEST&lt;/b&gt;&lt;br&gt;resolve_source(&amp;quot;fyp_documents&amp;quot;,&lt;br&gt;folder=True)&lt;br&gt;explicit .pdf/.txt selection&lt;br&gt;SHA-256 per source file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="200" height="160" as="geometry" /></mxCell>
        <mxCell id="ins" value="&lt;b&gt;INSPECT&lt;/b&gt;&lt;br&gt;pypdf page-by-page extraction&lt;br&gt;pages, characters per source&lt;br&gt;empty-text check (OCR need)&lt;br&gt;result: 0 near-empty pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="200" height="160" as="geometry" /></mxCell>
        <mxCell id="prep" value="&lt;b&gt;PREPARE / TRANSFORM&lt;/b&gt;&lt;br&gt;collapse spaces/tabs only&lt;br&gt;paragraph-aware chunks&lt;br&gt;&amp;lt;= 500 chars, split PER PAGE&lt;br&gt;attach source_id, title,&lt;br&gt;page, source SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="200" height="160" as="geometry" /></mxCell>
        <mxCell id="val" value="&lt;b&gt;VALIDATE OUTPUT&lt;/b&gt;&lt;br&gt;file exists, non-empty&lt;br&gt;no empty chunk, unique IDs&lt;br&gt;every chunk has a page&lt;br&gt;read-back = written records&lt;br&gt;output SHA-256 + bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="990" y="110" width="200" height="160" as="geometry" /></mxCell>
        <mxCell id="lin" value="&lt;b&gt;RECORD LINEAGE&lt;/b&gt;&lt;br&gt;source -&amp;gt; output mapping&lt;br&gt;records per source&lt;br&gt;pipeline_manifest.json&lt;br&gt;week3_manifest.json&lt;br&gt;Cell 9 rerun: PASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="200" height="160" as="geometry" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;FAILURE 1 — wrong / changed source&lt;/b&gt;&lt;br&gt;Trigger: handbook replaced, or wrong file selected&lt;br&gt;Detect: SHA-256 mismatch (Cell 6B / Cell 9),&lt;br&gt;changed record counts&lt;br&gt;Response: stop; update inventory version;&lt;br&gt;rerun pipeline (NFR4 &amp;lt; 10 min); re-register lineage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="330" height="150" as="geometry" /></mxCell>
        <mxCell id="f1" value="&lt;b&gt;FAILURE 2 — unusable text&lt;/b&gt;&lt;br&gt;Trigger: scanned/image-only PDF, or garbled text&lt;br&gt;(e.g. letter-spaced headings in S02)&lt;br&gt;Detect: empty-text check raises; near-empty pages&lt;br&gt;Response: stop; flag source in inventory;&lt;br&gt;add OCR or replace the source before re-ingesting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="390" y="330" width="330" height="150" as="geometry" /></mxCell>
        <mxCell id="out" value="&lt;b&gt;PREPARED CORPUS (420 chunks)&lt;/b&gt;&lt;br&gt;data/pipeline_v1/documents/prepared_text.jsonl&lt;br&gt;identical to Part B data/processed/prepared_text.jsonl&lt;br&gt;(same records, same SHA-256 — Cell 9B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="750" y="330" width="440" height="110" as="geometry" /></mxCell>
        <mxCell id="art" value="&lt;b&gt;LINEAGE ARTEFACTS&lt;/b&gt;&lt;br&gt;data/week3_manifest.json&lt;br&gt;data/pipeline_v1/documents/&lt;br&gt;pipeline_manifest.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1230" y="330" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="ctx" value="&lt;b&gt;Departmental FYP Knowledge Sources&lt;/b&gt;&lt;br&gt;Week 2 V1 architecture component (now prepared,&lt;br&gt;page-cited text for FR1, FR3, FR4/RAI1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="750" y="510" width="440" height="90" as="geometry" /></mxCell>
        <mxCell id="fut" value="&lt;b&gt;LATER (not in Topic 3)&lt;/b&gt;&lt;br&gt;embeddings + vector index&lt;br&gt;-&amp;gt; retrieval -&amp;gt; LLM service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=top;spacingTop=6;spacingLeft=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1230" y="510" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="note" value="&lt;b&gt;Pipeline type: batch ETL&lt;/b&gt;&lt;br&gt;Extract (pypdf) -&amp;gt; Transform (clean + page-aware chunk) -&amp;gt; Load (JSONL corpus).&lt;br&gt;Raw PDFs are kept unchanged in data/raw, so the corpus can be rebuilt at any time.&lt;br&gt;Sources change at most once per semester, so batch re-runs meet NFR4; streaming is not needed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=11;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="690" height="80" as="geometry" /></mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="src" target="ing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="ing" target="ins"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="ins" target="prep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="prep" target="val"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="val" target="lin"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="prep" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="lin" target="art"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="out" target="ctx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#888888;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="ctx" target="fut"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="f2" target="ing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="f1" target="ins"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="trace" value="Traceability: FR1 &amp; FR3 need rule text · FR4/RAI1 need title + page per passage · NFR4 needs a rerunnable, checksummed batch pipeline." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="1400" height="30" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
